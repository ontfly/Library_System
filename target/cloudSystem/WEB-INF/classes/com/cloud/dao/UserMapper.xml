<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.systcloud.dao.UserMapper">

    <select id="logind" parameterType="com.systcloud.domain.User" resultType="com.systcloud.domain.User" resultMap="userMap">
        select * from user where user_email=#{email} and user_password=#{password}
    </select>
    <resultMap id="userMap" type="com.systcloud.domain.User" >
        <id property="id" column="user_id"/>
        <result column="user_name" property="name"/>
        <result column="user_password" property="password"/>
        <result column="user_status" property="status"/>
        <result column="user_role" property="role"/>
        <result column="user_email" property="email"/>
    </resultMap>
    <select id="findaccount" parameterType="String" resultMap="userMap">
        select * from user where user_id=#{id}
    </select>
    <select id="usermanage" resultMap="userMap">
        select * from user where 1=1
    </select>
    <update id="logindd" parameterType="com.systcloud.domain.User">
        update user set user_status=#{status} where user_email = #{email}
    </update>
    <update id="logout" parameterType="com.systcloud.domain.User">
        update user set user_status=#{status} where user_email = #{email}
    </update>
    <delete id="deleteuserById" parameterType="com.systcloud.domain.User">
        delete from user where user_id=#{id}

    </delete>
    <insert id="addUser" >
        insert into user(
        user_name,user_email,user_role,user_password)
        values(#{name},#{email},#{role},#{password})
    </insert>

    <update id="edituser" parameterType="com.systcloud.domain.User">
        update user
        <trim prefix="set" suffixOverrides=",">
            <if test="name != null">user_name = #{name},</if>
            <if test="email != null">user_email = #{email},</if>
            <if test="password != null">user_password = #{password},</if>
            <if test="role != null">user_role = #{role},</if>
            <if test="status != null">user_status = #{status},</if>
        </trim>
        where user_id=#{id}
    </update>

</mapper>